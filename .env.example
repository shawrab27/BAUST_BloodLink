# ==============================================================================
# BAUST BloodLink — Production & Local Environment Variable Checklist
# ==============================================================================

# ─── BACKEND / SERVERLESS FUNCTIONS (Vercel Project Settings > Environment Variables) ───
# MongoDB Atlas Connection String (M0 Free Tier or higher)
# Mongoose connection is cached on global across serverless invocations.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/bloodlink?retryWrites=true&w=majority

# JWT Signing Secret (Minimum 32 characters long random string)
# Generated via: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=baust_bloodlink_super_secure_production_jwt_signing_key_2026_min32chars

# JWT Expiry window (8 hours required by spec)
JWT_EXPIRES_IN=8h

# Firebase Admin SDK Credentials (FCM Server-Side Channel)
# Download from Firebase Console > Project Settings > Service Accounts > Generate New Private Key
FIREBASE_PROJECT_ID=baust-bloodlink-fcm
FIREBASE_PRIVATE_KEY_ID=your_private_key_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_RSA_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@baust-bloodlink-fcm.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your_client_id

# CORS Allowed Origins (Comma-separated, no spaces)
CORS_ORIGINS=https://baust-bloodlink.vercel.app,https://blood.baust.edu.bd,http://localhost:5173

# Node Environment
NODE_ENV=production

# ─── FRONTEND (Vite / React Client Build Variables) ───────────────────────────
# Firebase Web App Config (Firebase Console > Project Settings > General > Web App)
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=baust-bloodlink-fcm.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=baust-bloodlink-fcm
VITE_FIREBASE_STORAGE_BUCKET=baust-bloodlink-fcm.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# VAPID Public Key Pair for Web Push
# (Firebase Console > Project Settings > Cloud Messaging > Web Push Certificates)
VITE_FIREBASE_VAPID_KEY=BKag9nM...
