        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\nskinparam shadowing false\nskinparam roundcorner 6\nskinparam defaultFontName Arial\nskinparam linetype ortho\n\n&#39; --- Global Theme ---\nskinparam class {\n    BackgroundColor #FFFFFF\n    ArrowColor #2563EB\n    BorderColor #1E293B\n    FontColor #0F172A\n    HeaderBackgroundColor #DBEAFE\n}\n\nskinparam enum {\n    BackgroundColor #F8FAFC\n    BorderColor #475569\n    HeaderBackgroundColor #E2E8F0\n}\n\n&#39; --- Custom Color Per Class ---\nskinparam class&lt;&lt;UserStyle&gt;&gt; {\n    HeaderBackgroundColor #BFDBFE\n    BorderColor #1D4ED8\n}\n\nskinparam class&lt;&lt;DonorStyle&gt;&gt; {\n    HeaderBackgroundColor #BBF7D0\n    BorderColor #15803D\n}\n\nskinparam class&lt;&lt;RequestStyle&gt;&gt; {\n    HeaderBackgroundColor #FECDD3\n    BorderColor #BE123C\n}\n\nskinparam class&lt;&lt;FeedStyle&gt;&gt; {\n    HeaderBackgroundColor #FED7AA\n    BorderColor #C2410C\n}\n\nskinparam class&lt;&lt;MedicalStyle&gt;&gt; {\n    HeaderBackgroundColor #DDD6FE\n    BorderColor #6D28D9\n}\n\n&#39; --- Enumerations ---\nenum Role {\n  STUDENT\n  TEACHER\n  STAFF\n  ADMIN\n}\n\nenum BloodGroup {\n  A_POS\n  A_NEG\n  B_POS\n  B_NEG\n  AB_POS\n  AB_NEG\n  O_POS\n  O_NEG\n  BOMBAY\n}\n\n&#39; --- Classes ---\nclass User &lt;&lt;UserStyle&gt;&gt; {\n  - userId: ObjectId\n  - campusId: String\n  - fullName: String\n  - email: String\n  - passwordHash: String\n  - role: Role\n  - isVerified: Boolean\n  --\n  + register(): Boolean\n  + login(): String\n  + updateProfile(): Void\n}\n\nclass Donor &lt;&lt;DonorStyle&gt;&gt; {\n  - bloodGroup: BloodGroup\n  - isRareGroup: Boolean\n  - isAvailable: Boolean\n  - isDisasterReady: Boolean\n  - lastDonationDate: Date\n  --\n  + toggleAvailability(): Boolean\n  + respondToSOS(requestId: ObjectId): Void\n}\n\nclass BloodRequest &lt;&lt;RequestStyle&gt;&gt; {\n  - requestId: ObjectId\n  - requesterId: ObjectId\n  - patientLocation: String\n  - bloodGroup: BloodGroup\n  - urgencyLevel: String\n  - isEmergency: Boolean\n  - verificationStatus: String\n  - createdAt: Date\n  --\n  + createSOS(): Void\n  + verifyRequest(adminId: ObjectId): Void\n  + closeRequest(): Void\n}\n\nclass FeedPost &lt;&lt;FeedStyle&gt;&gt; {\n  - postId: ObjectId\n  - authorId: ObjectId\n  - content: String\n  - mediaUrl: String\n  - createdAt: Date\n  --\n  + createPost(): Void\n  + fetchFeed(cursor: ObjectId): List\n}\n\nclass MedicalContact &lt;&lt;MedicalStyle&gt;&gt; {\n  - staffId: String\n  - staffName: String\n  - designation: String\n  - emergencyHotline: String\n  --\n  + initiateCall(): Void\n}\n\n&#39; --- Relationships ---\nUser &lt;|-- Donor : extends\nUser \&quot;1\&quot; o-- \&quot;0..*\&quot; FeedPost : authors\nUser \&quot;1\&quot; o-- \&quot;0..*\&quot; BloodRequest : creates\nBloodRequest \&quot;0..*\&quot; ..&gt; \&quot;1\&quot; MedicalContact : triggers alert\n\nUser ..&gt; Role\nDonor ..&gt; BloodGroup\nBloodRequest ..&gt; BloodGroup\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="oTne7jVcN98dMZvdy5L9-315">
